/* Default 1v1 composition geometry. Component appearance lives in GameplayTheme.uss. */
.table-cards, #board-navigation, #battlefield-links { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
#table-phase { position: absolute; top: 16px; left: 205px; width: 300px; white-space: normal; padding: 3px 10px; }
#opponent-hand { position: absolute; top: -68px; left: 50%; margin-left: -235px; width: 470px; height: 115px; }
.opponent-hand-back { position: absolute; width: 70px; height: 100px; }
#table-choices { position: absolute; right: 20px; bottom: 35px; width: 275px; max-height: 285px; }
#table-choices #decision-controls { flex-direction: column; }
#table-choices #decision-mana-pool { white-space: normal; }
#table-choices Button { flex-grow: 0; min-width: 110px; white-space: normal; }
#table-choices .mf-primary { margin-top: 8px; margin-bottom: 4px; }
#board-choice-alternatives { margin-top: 3px; margin-bottom: 4px; }
#table-choices.opening-choices { width: 520px; right: 50%; margin-right: -260px; bottom: 35px; max-height: 170px; }
#table-choices.opening-choices #decision-controls { flex-direction: row; justify-content: center; }
#table-choices.opening-choices .mf-action { width: 190px; margin-left: 20px; margin-right: 20px; flex-shrink: 0; }
#table-choices.opening-choices #decision-prompt { -unity-text-align: middle-center; }
#table-zones { position: absolute; left: 24px; bottom: 205px; width: 110px; white-space: normal; }
#live-markers { position: absolute; bottom: 20px; left: 3px; right: 3px; white-space: normal; -unity-text-align: middle-center; }
.table-inspection { position: absolute; left: 25px; top: 95px; }
#close-inspection { position: absolute; left: 25px; top: 60px; width: 290px; height: 30px; }
#table-result { position: absolute; top: 35%; left: 25%; right: 25%; padding: 30px; -unity-text-align: middle-center; white-space: normal; }
#table-motion { position: absolute; right: 20px; top: 16px; }
.row-navigation { position: absolute; flex-direction: row; align-items: center; }
.row-navigation Button { min-width: 26px; height: 28px; }
#board-input-hint { position: absolute; top: 45%; left: 200px; right: 315px; -unity-text-align: middle-center; padding: 4px; }
#board-drag-ghost { position: absolute; padding: 8px; }
#board-object-menu { position: absolute; width: 300px; max-height: 260px; padding: 12px; }
#board-object-menu Button { white-space: normal; }
.library-flight { position: absolute; width: 80px; height: 112px; -unity-text-align: middle-center; }
#public-zone-choices { position: absolute; left: 18px; bottom: 92px; width: 160px; }
#public-zone-choices Button { min-height: 30px; margin-top: 4px; white-space: normal; }
#public-zone-drawer { position: absolute; left: 150px; right: 150px; top: 24%; bottom: 29%; padding: 18px; }
#close-public-zone { position: absolute; right: 16px; top: 14px; height: 30px; }
#stack-title { position: absolute; right: 20px; top: 31%; width: 130px; -unity-text-align: middle-center; }
#hand-navigation { height: 26px; }
#arena-table #table-result { padding-top: 44px; padding-bottom: 44px; }
#arena-table.browsing-public-zone #board-input-hint, #arena-table.browsing-public-zone #battlefield-links { visibility: hidden; }
#arena-table .zone-pile { position: absolute; overflow: visible; }
#public-zone-drawer { top: 16%; bottom: 21%; }

#arena-table.opening-state .zone-pile { visibility: hidden; }
#table-choices.library-ordering { left: 15%; right: 15%; top: 18%; bottom: auto; width: auto; max-height: 65%; }
#table-choices.library-ordering #viewer-decision-panel { padding: 18px; }
#table-choices.library-ordering #decision-prompt { white-space: normal; flex-shrink: 0; }
#table-choices.library-ordering #decision-controls { flex-direction: row; flex-wrap: wrap; align-items: flex-start; }
#library-order-help { width: 100%; margin-bottom: 12px; white-space: normal; }
#library-choice { width: 170px; margin: 6px; padding: 6px; }
#library-choice Button { width: 100%; min-height: 52px; white-space: normal; }
#unity-priority-controls { position: absolute; right: 16px; top: 16px; width: 285px; padding: 10px; }
#unity-priority-controls .unity-toggle__label, #unity-priority-controls .unity-foldout__text { white-space: normal; }
#unity-priority-status { white-space: normal; margin-top: 4px; margin-bottom: 4px; }
#unity-priority-controls Button { white-space: normal; min-height: 28px; margin-top: 4px; }
#unity-priority-stops { max-height: 230px; margin-top: 8px; }

/* Composition only: expanded bodies retain the previous choice and pile anchors. */
.arena-player-hud { position: absolute; left: 16px; top: 54px; width: 252px; }
.arena-player-hud > .mf-hud-players { height: 88px; flex-shrink: 0; }
.arena-player-hud > .mf-hud-commanders { position: absolute; left: 0; right: 0; top: 224px; bottom: 0; }
#action-drawer .mf-drawer-content { max-height: 285px; }
#action-drawer.opening-choices .mf-drawer-content { max-height: 170px; }
#action-drawer.library-ordering .mf-drawer-content { max-height: 100%; }
#action-drawer #table-choices { position: relative; left: auto; right: auto; top: auto; bottom: auto; width: auto; margin-right: 0; max-height: 100%; flex-shrink: 1; }
#priority-drawer { right: 16px; top: 16px; width: 285px; max-height: 70%; }
#priority-drawer #unity-priority-controls { position: relative; right: auto; top: auto; width: auto; }
#priority-drawer .mf-drawer-content { flex-shrink: 1; overflow: hidden; }
#zones-drawer .mf-drawer-viewport { padding-top: 0; }
#zones-drawer .mf-drawer-viewport, #zones-drawer .mf-drawer-content { flex-shrink: 1; }
#table-motion { top: auto; bottom: 8px; right: 20px; }

/* Persistent edge handles: content geometry must not move the handles. */
#action-drawer, #action-drawer.opening-choices, #action-drawer.library-ordering { left: auto; top: auto; right: 20px; bottom: 35px; width: 275px; height: 30px; max-height: 30px; margin-right: 0; }
#action-drawer > .mf-drawer-viewport { position: absolute; padding-top: 0; bottom: 32px; right: 0; width: 275px; overflow: hidden; }
#zones-drawer { left: 16px; top: auto; bottom: 92px; width: 252px; height: 30px; }
#zones-drawer > .mf-drawer-tab { top: 0; bottom: auto; }
#zones-drawer > .mf-drawer-viewport { position: absolute; left: 0; width: 252px; padding-top: 0; }
#zone-panel-scroll { width: 252px; }
#zone-panel-scroll .unity-scroll-view__content-container { min-width: 232px; }
